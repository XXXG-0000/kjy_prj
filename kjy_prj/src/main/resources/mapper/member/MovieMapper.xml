<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.sist.kjy_prj.member.main.MainDAO">

    <resultMap id="movieResultMap" type="kr.co.sist.kjy_prj.member.domain.MovieOneDomain">
        <id property="movie_num" column="movie_num" />
        <result property="title_k" column="title_k" />
        <result property="title_e" column="title_e" />
        <result property="audience_rating" column="audience_rating" />
        <result property="rate" column="rate" />
        <result property="showtime" column="showtime" />
        <result property="release_date" column="release_date" jdbcType="DATE" />
        <result property="main_image" column="main_image" />
        <result property="info" column="info" />
        <result property="screening_f" column="screening_f" />


        <!-- 1:N 매핑 - 감독들 -->
        <collection property="directors" ofType="kr.co.sist.kjy_prj.member.domain.SuperVisionDomain">
            <result property="s_name" column="director_name"/>
            <result property="director_image" column="director_image"/>
        </collection>

        <!-- 1:N 매핑 - 배우들 -->
        <collection property="actors" ofType="kr.co.sist.kjy_prj.member.domain.CastDomain">
            <result property="actor" column="actor"/>
            <result property="image" column="image"/>
            <result property="filmography" column="filmography"/>
            <result property="star_f" column="star_f"/>
        </collection>

        <!-- 1:N 매핑 - 장르들 -->
        <collection property="genres" ofType="kr.co.sist.kjy_prj.member.domain.GenreDomain">
            <result property="g_name" column="genre_name"/>
        </collection>

        <!-- 1:N 매핑 - 국가들 -->
        <collection property="conutries" ofType="kr.co.sist.kjy_prj.member.domain.ConutryDomain">
            <result property="country_name" column="country_name"/>
        </collection>
    </resultMap>

    <select id="selectOneMovie" resultMap="movieResultMap" parameterType="int">
        SELECT
        m.movie_num,
        m.title_k,
        m.title_e,
        m.audience_rating,
        m.rate,
        m.screening_f,
        m.showtime,
        m.release_date,
        m.main_image,
        m.info,
        s.s_name AS director_name,
        s.image AS director_image,
        c.actor,
        c.image,
        c.filmography,
        c.star_f,
        g.g_name AS genre_name,
        co.country_name
        FROM movie m
        LEFT JOIN supervision s ON m.movie_num = s.movie_num
        LEFT JOIN cast c ON m.movie_num = c.movie_num
        LEFT JOIN genre g ON m.movie_num = g.movie_num
        LEFT JOIN country co ON m.movie_num = co.movie_num
        WHERE m.movie_num = #{movie_num}
    </select>

    <select id="selectMovieReview" parameterType="int" resultType="kr.co.sist.kjy_prj.member.domain.ReviewDomain">
        select r.review, r.review_f, r.review_date,re.member_id, m.profile
        from review r
        left join reservation re on r.re_num = re.re_num
        left join member m on m.member_id = re.member_id
        where r.movie_num =#{movie_num}
    </select>


</mapper>

